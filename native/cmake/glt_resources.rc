// ─────────────────────────────────────────────────────────────────────────────
// GameLoop Tuner — Windows resources.
//
// RT_MANIFEST → app.manifest, which carries:
//     <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
// So Windows raises the UAC prompt *before* the process image is mapped,
// instead of the app popping a messagebox at runtime like the Python build did.
//
// IDI_ICON1 → mythic.ico, the same icon the Python/PyInstaller build shipped.
//
// WHY THE RESOURCE, NOT /MANIFESTINPUT
// ------------------------------------
// Embedding the manifest in the .rc AND passing /MANIFEST:EMBED with
// /MANIFESTINPUT gives mt.exe two snippets that disagree — the linker-generated
// one says asInvoker, ours says requireAdministrator — and the link dies with
//   LNK1327: manifest authoring error c1010001:
//   Values of attribute "level" not equal in different manifest snippets
// The .rc is the single source of truth here, and CMakeLists passes
// /MANIFEST:NO so the linker does not synthesise a competing one.
// ─────────────────────────────────────────────────────────────────────────────

#include <winresrc.h>

// CREATEPROCESS_MANIFEST_RESOURCE_ID is 1, which is where the loader looks.
1 RT_MANIFEST "app.manifest"

1 ICON "mythic.ico"

// ── VERSIONINFO ─────────────────────────────────────────────────────────────
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "realLLUKS"
            VALUE "FileDescription",  "GameLoop Tuner"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "GameLoopTuner"
            VALUE "LegalCopyright",   "Copyright (C) 2026 realLLUKS"
            VALUE "OriginalFilename", "GameLoopTuner.exe"
            VALUE "ProductName",      "GameLoop Tuner"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END