// ─────────────────────────────────────────────────────────────────────────────
// GameLoop Tuner Setup — Windows resources.
//
// Same shape as glt_resources.rc, but a DIFFERENT manifest: this one is
// asInvoker. The app requires elevation because it has to kill SYSTEM-owned
// processes; the installer only writes to Program Files and can therefore ask
// for elevation at the moment it needs it (see main.cpp).
//
// Embedding the manifest in the .rc and passing /MANIFEST:NO is the same
// single-source-of-truth arrangement documented in glt_resources.rc — letting
// the linker synthesise a competing snippet is what produces LNK1327.
// ─────────────────────────────────────────────────────────────────────────────

#include <winresrc.h>

// CREATEPROCESS_MANIFEST_RESOURCE_ID is 1, which is where the loader looks.
1 RT_MANIFEST "setup.manifest"

1 ICON "mythic.ico"

// ── VERSIONINFO ─────────────────────────────────────────────────────────────
//
// Mirrors glt_resources.rc so the two binaries are not confused in Task
// Manager or Programs and Features.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "realLLUKS"
            VALUE "FileDescription",  "GameLoop Tuner Setup"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "GameLoopTunerSetup"
            VALUE "LegalCopyright",   "Copyright (C) 2026 realLLUKS"
            VALUE "OriginalFilename", "GameLoopTunerSetup.exe"
            VALUE "ProductName",      "GameLoop Tuner"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END